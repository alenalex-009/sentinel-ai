# Server-side secrets for Sentinel AI backend. NEVER commit this file.
# Copy to backend/.env and fill values. All values stay server-side only.
# The frontend never receives these; it reads aggregated/derived API data.

# WeatherAPI.com key (current + forecast + alerts consumer)
# https://www.weatherapi.com/
WEATHER_API_KEY=

# USGS India earthquakes historical CSV (raw source for ingestion)
# Example: C:\Users\User\Downloads\USGS_India_Earthquakes_2000_2026 (1) (1).csv
EARTHQUAKE_CSV_PATH=

# PostGIS connection for the backend when not running through docker-compose
# DATABASE_URL=postgresql://sentinel:sentinel_dev@localhost:5432/sentinel_ai