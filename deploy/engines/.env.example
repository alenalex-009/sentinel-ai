# Sentinel AI routing engines - configuration
#
# Copy to `.env` next to this file to override defaults. Created variables are
# read by both docker-compose.yml and up.ps1.

# Dataset all three routing engines use. Geofabrik discontinued the standalone
# Kerala extract (2026); the default is Geofabrik's "southern zone" (contains
# Kerala + adjacent southern states). The local file is always normalized to
# data/osrm/kerala-latest.osm.pbf.
# KERALA_PBF_URL=https://download.geofabrik.de/asia/india/southern-zone-latest.osm.pbf